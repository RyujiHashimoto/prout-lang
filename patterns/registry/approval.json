{
  "name": "approval",
  "version": "0.3.0",
  "intent": "申請を承認者に回し、承認・差し戻し・却下の状態遷移を管理する。承認後の処理は on_approved フックで接続する",
  "tags": [
    "approval",
    "workflow",
    "request",
    "review",
    "申請",
    "承認",
    "差し戻し",
    "ワークフロー",
    "稟議"
  ],
  "slots": {
    "entity": {
      "type": "entity",
      "required": true,
      "desc": "申請対象のエンティティ"
    },
    "approver": {
      "type": "role",
      "required": true,
      "desc": "承認ロール"
    },
    "on_approved": {
      "type": "hook",
      "required": false,
      "desc": "承認後に呼ぶ処理（custom、または channel と recipient を渡す notify）"
    }
  },
  "states": [
    "draft",
    "pending",
    "approved",
    "returned",
    "rejected"
  ],
  "transitions": [
    {
      "from": "draft",
      "on": "submit",
      "to": "pending",
      "effect": "notify(approver)"
    },
    {
      "from": "pending",
      "on": "approve",
      "to": "approved",
      "effect": "emit(audit)"
    },
    {
      "from": "pending",
      "on": "return",
      "to": "returned",
      "effect": "notify(applicant)"
    },
    {
      "from": "pending",
      "on": "reject",
      "to": "rejected",
      "effect": "notify(applicant)"
    },
    {
      "from": "returned",
      "on": "resubmit",
      "to": "pending"
    }
  ],
  "hooks": {
    "on_approved": {
      "kind": "custom_or_pattern",
      "required": false,
      "pattern": "notify",
      "args": ["channel", "recipient"]
    }
  },
  "requires_fields": {
    "status": "String"
  },
  "effects": [
    "write(approvals)",
    "notify(approver)",
    "emit(audit)"
  ],
  "artifacts": [
    {
      "path": "db/schema.sql#approvals",
      "kind": "SQL",
      "lines": 18,
      "desc": "approvals, approval_steps, audit_log"
    },
    {
      "path": "api/approvals/route.ts",
      "kind": "API",
      "lines": 70,
      "desc": "申請の作成と一覧"
    },
    {
      "path": "api/approvals/[id]/route.ts",
      "kind": "API",
      "lines": 55,
      "desc": "承認・差し戻し・却下"
    },
    {
      "path": "app/(admin)/approvals/page.tsx",
      "kind": "UI",
      "lines": 85,
      "desc": "承認待ち一覧"
    },
    {
      "path": "app/(admin)/approvals/[id]/page.tsx",
      "kind": "UI",
      "lines": 70,
      "desc": "申請詳細と承認ボタン"
    },
    {
      "path": "lib/workflows/approval.ts",
      "kind": "TS",
      "lines": 60,
      "desc": "状態遷移と on_approved フック"
    },
    {
      "path": "tests/approval.test.ts",
      "kind": "TEST",
      "lines": 75,
      "desc": "承認フローの契約テスト"
    }
  ],
  "data_policy": {
    "labels": ["pii", "internal"],
    "sources": {"entity": ["pii", "internal"]},
    "sinks": {
      "notify(approver)": {"accepts": ["pii", "internal"]},
      "notify(applicant)": {"accepts": ["pii", "internal"]},
      "emit(audit)": {"accepts": ["internal"]}
    },
    "rejects": {}
  },
  "examples": [
    "examples/expense.etsah",
    "examples/travel_request.etsah",
    "examples/equipment_purchase.etsah",
    "bench/pc_lending.etsah"
  ],
  "provenance": {
    "author": "橋元 龍二",
    "date": "2026-11-22",
    "extracted_from": [
      "expense",
      "pc_lending"
    ],
    "note": "経費精算とPC貸出の共通部分（申請→承認→差し戻し）を抽出した"
  }
}
